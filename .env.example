# Copy to .env in the repo root. The backend reads it at start-up, so the same
# settings work on Windows (PowerShell, cmd) and on macOS/Linux shells.
# Variables already set in the shell take precedence.
INNOVATION_ENABLED=1
# INNOVATION_RESEARCH_MODE=1
# LIVENESS_CHECKPOINT=checkpoints/liveness_best.pth
# TORCH_THREADS=1
